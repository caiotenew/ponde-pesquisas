    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.1"
  },
  "devDependencies": {
    "prisma": "6.19.0"
  },
  "allowScripts": {
    "prisma@6.19.0": true,
    "@prisma/client@6.19.0": true,
    "@prisma/engines@6.19.0": true
